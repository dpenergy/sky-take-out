<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 声明的内容会覆盖掉父工程中声明的组织和版本 -->
    <groupId>com.wudd</groupId>
    <artifactId>sky-take-out</artifactId>
    <version>1.0.1</version>
    <packaging>pom</packaging><!-- 父工程必须声明为pom打包方式 -->

    <modules>
        <module>common</module>
        <module>pojo</module>
        <module>server</module>
    </modules>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.9</version>
        <relativePath/> <!-- 去厂库中查找这个父工程 -->
    </parent>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis.version>4.0.1</mybatis.version>
        <mybatis-spring-boot-starter-test.version>4.0.1</mybatis-spring-boot-starter-test.version>
        <knife4j-openapi3-boot4-spring-boot-starter.version>5.7.9</knife4j-openapi3-boot4-spring-boot-starter.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <!-- 对于springboot起步依赖没有管理的版本，进行手动的版本管理 -->
    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter-test</artifactId>
                <version>${mybatis-spring-boot-starter-test.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.baizhukui</groupId>
                <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
                <version>${knife4j-openapi3-boot4-spring-boot-starter.version}</version>
            </dependency>
            <!-- 新版本jjwt令牌 -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <version>${jjwt.version}</version>
                <artifactId>jjwt-api</artifactId>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <version>${jjwt.version}</version>
                <artifactId>jjwt-impl</artifactId>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <version>${jjwt.version}</version>
                <artifactId>jjwt-jackson</artifactId>
                <scope>runtime</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>



</project>